.env
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
.DS_Store
*.tmp
archive/
config/oracle/
dist/
backups/
deploy/airgap/agent-installers/*
!deploy/airgap/agent-installers/README.md
# 설치 파일의 SHA-256 고정값은 저장소에 둔다 (make-bundle·CI 가 내려받은 파일을 이것으로 확인)
!deploy/airgap/agent-installers/*.sha256
# 반입 묶음을 푼 서버의 ./agent-installers (docker-compose.yml)
/agent-installers/
# TLS 인증서·개인키, CA 개인키 (ADR-036) — 저장소·이미지에 넣지 않는다
tls/
tls-ca/
# 에이전트 작업 공간 (Claude Code worktree)
.claude/worktrees/
