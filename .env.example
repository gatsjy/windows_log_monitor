# Log Monitor 설정. 이 파일을 .env 로 복사해서 값을 바꾼다:  cp .env.example .env
# .env 는 비밀번호/키가 들어가므로 git 에 올리지 않는다 (.gitignore 에 포함).
# 값을 비워 두면 docker-compose.yml 의 기본값(개발용)이 쓰인다. 운영에서는 반드시 바꿀 것.

# ---- PostgreSQL ----
POSTGRES_DB=wlm
POSTGRES_USER=wlm
POSTGRES_PASSWORD=change-me-strong-password

# ---- 이미지 ----
# 폐쇄망 설치(deploy/airgap/install.sh)가 반입한 버전으로 채운다. 되돌릴 때는 이전 버전 태그로 바꾸고 up -d
WLM_API_IMAGE=log-monitor-api:latest

# ---- 포트 ----
WLM_PORT=8080             # 웹 화면 + API (사용자가 접속하는 포트)
WLM_INGEST_PORT=6976      # 에이전트 로그 수집 전용 (Windows·Linux 에이전트가 보내는 포트, /api/ingest 만 열림)
WLM_DB_PORT=15432         # (개발용) 로컬에서 DB 직접 조회 — 127.0.0.1 에만 열림
WLM_SYSLOG_PORT=514       # syslog 수신기 RFC3164 (UDP/TCP) — --profile syslog 일 때만
WLM_SYSLOG_5424_PORT=1514 # syslog 수신기 RFC5424 (TCP)

# ---- 수집 ----
# 에이전트가 X-API-Key 헤더로 보내는 키. 콤마로 여러 개 가능 (키 교체 기간에 옛 키와 새 키를 같이 둔다)
# 생성 예:  openssl rand -hex 24
WLM_INGEST_API_KEYS=change-me-ingest-key
# syslog 수신기(collector 컨테이너)가 쓸 키 — 위 목록 중 하나
WLM_COLLECTOR_API_KEY=change-me-ingest-key

# ---- 로그 로테이션 / 상태 ----
WLM_DB_RETENTION_DAYS=90      # DB 에서 바로 검색되는 기간. 지나면 압축 보관 파일(archive/)로 옮긴다
WLM_RETENTION_DAYS=365        # 전체 보관 기간(보관 파일 포함). ISMS 접속기록 최소 1년 (조건에 따라 2년)
WLM_HEARTBEAT_ONLINE_SEC=90   # 이 시간 안에 수신하면 '온라인'
WLM_HEARTBEAT_STALE_SEC=900   # 이 시간 안이면 '지연', 넘으면 '오프라인'
WLM_LOG_LEVEL=INFO

# ---- 알림 ----
WLM_PUBLIC_URL=http://localhost:8080   # 알림의 "자세히 보기" 링크 주소. 운영에서는 사용자가 접속하는 주소로 (예: http://logmon.corp.local:8080)
WLM_DISPLAY_TZ=Asia/Seoul                      # 알림 본문 시각 표시 시간대
# 메일 서버 — 환경설정 화면에서 설정하면 화면 값이 우선. 여기는 기본값 (개발 환경은 Mailpit 으로 덮어씀)
WLM_SMTP_HOST=smtp.corp.local
WLM_SMTP_PORT=587
WLM_SMTP_SECURITY=starttls     # none | starttls | ssl
WLM_SMTP_USER=
WLM_SMTP_PASSWORD=
WLM_SMTP_FROM=log-monitor@corp.local
WLM_MAILPIT_PORT=8025          # (개발용) Mailpit 웹 화면

# ---- 환경설정 비밀값 암호화 키 ----
# 화면에서 입력하는 SMTP·Oracle 비밀번호, 웹훅 주소·토큰을 이 키로 암호화해 DB 에 저장한다.
# 생성: openssl rand -hex 32   — 잃어버리면 저장된 비밀값을 다시 입력해야 한다. DB 백업과 따로 보관
WLM_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ---- 인증 (기본값은 ISMS 심사에서 흔히 요구하는 수준) ----
WLM_SESSION_IDLE_MIN=30        # 조작이 없으면 자동 로그아웃 (분)
WLM_SESSION_MAX_HOURS=12       # 로그인 후 최대 유지 (시간)
WLM_LOGIN_MAX_FAILURES=5       # 연속 실패 시 계정 잠금
WLM_LOGIN_LOCKOUT_MIN=10       # 잠금 시간 (분)
WLM_PASSWORD_MAX_AGE_DAYS=90   # 비밀번호 변경 주기 (0 = 사용 안 함)
WLM_COOKIE_SECURE=false        # HTTPS(리버스 프록시) 뒤에서 운영하면 true
# 초기 관리자(admin) 비밀번호. 비우면 무작위 생성 후 서버 로그에 1회 출력 (첫 로그인 때 변경 강제)
# 주의: 값이 빈 줄 뒤에 '# 설명' 을 붙이면 docker compose 가 설명문을 값으로 읽는다 → 설명은 항상 윗줄에
WLM_ADMIN_INITIAL_PASSWORD=
WLM_API_DOCS=true              # /docs (API 문서) 노출. 운영에서 숨기려면 false

# ---- PostgreSQL 성능 (docs/PERFORMANCE.md §4) — 서버 메모리에 맞게 ----
WLM_PG_SHARED_BUFFERS=1GB          # 메모리의 25%
WLM_PG_EFFECTIVE_CACHE_SIZE=3GB    # 메모리의 50~75%
WLM_PG_WORK_MEM=32MB
WLM_PG_MAINTENANCE_WORK_MEM=256MB
WLM_PG_PARALLEL_WORKERS=4          # CPU 코어의 절반
