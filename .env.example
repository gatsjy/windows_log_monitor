# Log Monitor 설정. 이 파일을 .env 로 복사해서 값을 바꾼다:  cp .env.example .env
# .env 는 비밀번호/키가 들어가므로 git 에 올리지 않는다 (.gitignore 에 포함).
# 값을 비워 두면 docker-compose.yml 의 기본값(개발용)이 쓰인다. 운영에서는 반드시 바꿀 것.

# ---- PostgreSQL ----
POSTGRES_DB=wlm
POSTGRES_USER=wlm
POSTGRES_PASSWORD=change-me-strong-password

# ---- 이미지 ----
# 폐쇄망 설치(deploy/airgap/install.sh)가 반입한 버전으로 채운다. 되돌릴 때는 이전 버전 태그로 바꾸고 up -d
WLM_API_IMAGE=log-monitor-api:latest

# ---- 포트 ----
WLM_PORT=8080             # 웹 화면 + API (사용자가 접속하는 포트)
WLM_INGEST_PORT=6976      # 에이전트 로그 수집 전용 평문 (/api/ingest 만 열림). TLS 로 모두 옮긴 뒤 WLM_INGEST_PLAIN=off
WLM_INGEST_TLS_PORT=6977  # 에이전트 로그 수집 전용 TLS — WLM_TLS=on 일 때만 받음
WLM_DB_PORT=15432         # (개발용) 로컬에서 DB 직접 조회 — 127.0.0.1 에만 열림
WLM_SYSLOG_PORT=514       # syslog 수신기 RFC3164 (UDP/TCP) — --profile syslog 일 때만
WLM_SYSLOG_5424_PORT=1514 # syslog 수신기 RFC5424 (TCP)

# ---- 수집 ----
# 에이전트가 X-API-Key 헤더로 보내는 키. 콤마로 여러 개 가능 (키 교체 기간에 옛 키와 새 키를 같이 둔다)
# 생성 예:  openssl rand -hex 24
WLM_INGEST_API_KEYS=change-me-ingest-key
# syslog 수신기(collector 컨테이너)가 쓸 키 — 위 목록 중 하나
WLM_COLLECTOR_API_KEY=change-me-ingest-key

# ---- DB 백업 (backup 서비스, deploy/backup/backup.sh) ----
# 백업 파일은 backups/ 에 쌓인다. 이 폴더는 다른 디스크·NAS 로 옮겨 보관하고, 이 .env(암호화 키)는 백업과 따로 보관한다
WLM_BACKUP_TIME=02:30         # 매일 이 시각이 지나면 그날 한 번 백업 (HH:MM, WLM_DISPLAY_TZ 기준)
WLM_BACKUP_KEEP=14            # 남겨 둘 백업 개수, 1 이상 (넘으면 오래된 것부터 지움)
WLM_BACKUP_VERIFY_WEEKDAY=7   # 이 요일 백업 뒤 임시 DB 에 복원해 확인 (1=월 … 7=일, 0=안 함). DB 크기 + 1GB 여유 디스크가 필요

# ---- 점검 보고서 (일정·받는 곳은 환경설정 화면) ----
WLM_REPORT_SCHEDULER=on      # off 면 정기 보고서를 만들지 않는다 ('지금 만들기'만). 여러 대 중 한 대만 켤 때

# ---- 로그 로테이션 / 상태 ----
WLM_DB_RETENTION_DAYS=90      # DB 에서 바로 검색되는 기간. 지나면 압축 보관 파일(archive/)로 옮긴다
WLM_RETENTION_DAYS=365        # 전체 보관 기간(보관 파일 포함). ISMS 접속기록 최소 1년 (조건에 따라 2년)
# 기록 종류별 보관기간 (ADR-040). 법정 최소보다 짧으면 기동 로그·로그 보관 화면·점검 보고서가 알린다
#   진료정보(민감정보)를 처리하는 시스템의 접속기록이면 위 WLM_RETENTION_DAYS 를 730(2년) 이상으로
WLM_AUDIT_RETENTION_DAYS=1095 # 감사로그(이 시스템의 접속·권한 부여·변경·말소 기록). 법정 최소 3년
WLM_REPORT_RETENTION_DAYS=1095  # 점검 보고서(점검 증적)
# 알림 이력 보관기간 — 정하지 않으면 WLM_RETENTION_DAYS 와 같다 (빈 값 뒤에 설명을 쓰지 않는다: compose 가 값으로 읽음)
# WLM_ALERT_RETENTION_DAYS=365
WLM_HEARTBEAT_ONLINE_SEC=90   # 이 시간 안에 수신하면 '온라인'
WLM_HEARTBEAT_STALE_SEC=900   # 이 시간 안이면 '지연', 넘으면 '오프라인'
WLM_LOG_LEVEL=INFO
WLM_SEARCH_TIMEOUT_SEC=30   # 화면 검색·통계 쿼리 하나의 최대 시간(초). 넘으면 멈추고 안내 (0 = 없음, ADR-035)

# ---- 알림 ----
WLM_PUBLIC_URL=http://localhost:8080   # 알림의 "자세히 보기" 링크 주소. 운영에서는 사용자가 접속하는 주소로 (예: http://logmon.corp.local:8080)
WLM_DISPLAY_TZ=Asia/Seoul                      # 알림 본문 시각 표시 시간대
# 메일 서버 — 환경설정 화면에서 설정하면 화면 값이 우선. 여기는 기본값 (개발 환경은 Mailpit 으로 덮어씀)
WLM_SMTP_HOST=smtp.corp.local
WLM_SMTP_PORT=587
WLM_SMTP_SECURITY=starttls     # none | starttls | ssl
WLM_SMTP_USER=
WLM_SMTP_PASSWORD=
WLM_SMTP_FROM=log-monitor@corp.local
WLM_MAILPIT_PORT=8025          # (개발용) Mailpit 웹 화면

# ---- 환경설정 비밀값 암호화 키 ----
# 화면에서 입력하는 SMTP·Oracle 비밀번호, 웹훅 주소·토큰을 이 키로 암호화해 DB 에 저장한다.
# 생성: openssl rand -hex 32   — 잃어버리면 저장된 비밀값을 다시 입력해야 한다. DB 백업과 따로 보관
WLM_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ---- 인증 (기본값은 ISMS 심사에서 흔히 요구하는 수준) ----
WLM_SESSION_IDLE_MIN=30        # 조작이 없으면 자동 로그아웃 (분)
WLM_SESSION_MAX_HOURS=12       # 로그인 후 최대 유지 (시간)
WLM_LOGIN_MAX_FAILURES=5       # 연속 실패 시 계정 잠금
WLM_LOGIN_LOCKOUT_MIN=10       # 잠금 시간 (분)
WLM_PASSWORD_MAX_AGE_DAYS=90   # 비밀번호 변경 주기 (0 = 사용 안 함)
WLM_COOKIE_SECURE=false        # https 요청은 자동으로 Secure 쿠키. true = http 에서도 강제(그러면 http 로그인 거부)
# 초기 관리자(admin) 비밀번호. 비우면 무작위 생성 후 서버 로그에 1회 출력 (첫 로그인 때 변경 강제)
# 주의: 값이 빈 줄 뒤에 '# 설명' 을 붙이면 docker compose 가 설명문을 값으로 읽는다 → 설명은 항상 윗줄에
WLM_ADMIN_INITIAL_PASSWORD=
WLM_API_DOCS=true              # /docs (API 문서) 노출. 운영에서 숨기려면 false

# ---- HTTPS·에이전트 TLS (docs/AIRGAP.md §7.5, ADR-036) ----
# on: 화면(WLM_PORT)과 TLS 수집(WLM_INGEST_TLS_PORT)을 HTTPS 로. 인증서는 ./tls/ (server.crt, server.key, ca.crt)
#     만들기: python -m app.cli tls-init (AIRGAP §7.5). 켜면 WLM_PUBLIC_URL 도 https://<인증서 이름>:<포트> 로
WLM_TLS=off
# 평문 수집(WLM_INGEST_PORT) 리스너. 수집 PC 화면에서 '평문 PC 0대' 를 확인한 뒤 off
WLM_INGEST_PLAIN=on
# X-Forwarded-For/Proto 를 믿을 리버스 프록시 IP·CIDR (콤마). 앞에 프록시가 없으면 비워 둔다. '*'·0.0.0.0/0 은 기동 거부
WLM_TRUSTED_PROXIES=
# HSTS 초. 비우면 보내지 않음. DNS 이름으로 접속하고 HTTPS 가 안정된 뒤 86400 → 15552000. 되돌리기 어려우니 마지막에
# 되돌릴 때: 0 으로 두고(브라우저에 'max-age=0' 을 보내 지움) 사용자가 https 로 한 번씩 들어온 뒤 TLS 를 끈다
WLM_HSTS_MAX_AGE=

# ---- 메모리·PostgreSQL 성능 (docs/PERFORMANCE.md §4) — 서버 메모리에 맞게 ----
# 아래는 4GB 서버 기준. 8GB 서버: 1GB / 3GB / 32MB / 256MB / 4 / 1g / 3g / 1g
WLM_PG_SHARED_BUFFERS=512MB        # 메모리의 12~25%
WLM_PG_EFFECTIVE_CACHE_SIZE=1536MB # 메모리의 40~75%
WLM_PG_WORK_MEM=16MB
WLM_PG_MAINTENANCE_WORK_MEM=128MB
WLM_PG_PARALLEL_WORKERS=2          # CPU 코어의 절반
WLM_PG_SHM_SIZE=512m
WLM_DB_MEM_LIMIT=1536m             # db 컨테이너 상한
WLM_API_MEM_LIMIT=768m             # api 컨테이너 상한
