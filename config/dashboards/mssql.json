      },
      "up_is_good": false,
      "color": "var(--critical)"
    },
    {
      "type": "stat",
      "title": "백업 완료 (18264)",
      "w": 3,
      "metric": "count",
      "query": {
        "category": "mssql",
        "event_id": "18264"
      },
